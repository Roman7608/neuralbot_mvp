# Vikingi: автозапуск и корректная остановка стека Docker Compose.
#
# Установка (один раз, от root):
#   sudo cp /home/vikingi/VikingiAll/deploy/systemd/vikingi-compose.service /etc/systemd/system/
#   sudo systemctl daemon-reload
#   sudo systemctl enable vikingi-compose.service
#   sudo systemctl start vikingi-compose.service
#
# Статус: sudo systemctl status vikingi-compose.service
# Логи:  journalctl -u vikingi-compose.service -b

[Unit]
Description=Vikingi Docker Compose stack
Documentation=file:///home/vikingi/VikingiAll
After=docker.service network-online.target
Wants=network-online.target docker.service

[Service]
Type=oneshot
RemainAfterExit=yes
User=vikingi
Group=vikingi
SupplementaryGroups=docker
WorkingDirectory=/home/vikingi/VikingiAll
Environment=HOME=/home/vikingi
# Таймаут на случай долгого down при выключении ОС
TimeoutStopSec=120
ExecStart=/usr/bin/docker compose up -d
ExecStop=/usr/bin/docker compose down

[Install]
WantedBy=multi-user.target
