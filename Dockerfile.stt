# PyTorch 2.7 + CUDA 12.8 — поддержка RTX 50-series (sm_120 / Blackwell).
FROM pytorch/pytorch:2.7.0-cuda12.8-cudnn9-runtime

ENV DEBIAN_FRONTEND=noninteractive
ENV PYTHONUNBUFFERED=1
ENV PIP_NO_CACHE_DIR=1

RUN apt-get update && apt-get install -y --no-install-recommends \
    libsndfile1 ffmpeg \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app

COPY services/stt/requirements-docker.txt /app/requirements.txt
COPY services/stt/constraints.txt /app/constraints.txt
RUN pip install --upgrade pip setuptools wheel && \
    pip install --timeout 300 --retries 5 \
    -i https://mirror.yandex.ru/pypi/simple/ \
    --extra-index-url https://pypi.org/simple \
    --trusted-host mirror.yandex.ru \
    -r requirements.txt -c constraints.txt

COPY services/stt/main.py /app/main.py
COPY licensing/ /app/licensing/
COPY license.key /app/license.key
# GigaAM-v3 e2e_ctc — для голосового бота (лучше распознаёт ключевые слова: Чери, слесарный цех)
COPY models/gigaam-v3/ /app/models/gigaam-v3/

ENV STT_ENGINE=gigaam
ENV GIGAAM_MODEL_PATH=/app/models/gigaam-v3

EXPOSE 8001

CMD ["uvicorn", "main:app", "--host", "0.0.0.0", "--port", "8001"]
